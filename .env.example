# Copy to .env (gitignored) and fill in. The publish scripts pass these to the database environment.
# Gemini key: https://aistudio.google.com/apikey
AI_API_KEY=
# Optional overrides (defaults: Gemini OpenAI-compatible endpoint, model gemini-3.5-flash,
# fallback gemini-3.5-flash-lite when the main model is overloaded)
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# AI_MODEL=
# AI_VISION_MODEL=
# AI_FALLBACK_MODEL=
# Help Bot on iMessage via Photon (optional; spacetimedb/Photon.cs). Webhook URL:
#   https://<spacetimedb host>/v1/database/<db>/route/photon
# PHOTON_API_KEY=pho_sk_...          # project key with project:read + project:write
# PHOTON_PROJECT_ID=                  # defaults to the projectId in each webhook event
# PHOTON_WEBHOOK_SECRET=whsec_...     # signing secret shown when you add the webhook destination
# PHOTON_BASE_URL=https://api.photon.codes
# Help Bot on Discord (optional; spacetimedb/Discord.cs). Interactions Endpoint URL:
#   https://<spacetimedb host>/v1/database/<db>/route/discord
# DISCORD_APPLICATION_ID=            # Developer Portal → General Information → Application ID
# DISCORD_PUBLIC_KEY=                # General Information → Public Key (hex); verifies every request
# DISCORD_API_BASE=https://discord.com/api/v10
# DISCORD_BOT_TOKEN=                 # Bot → Reset Token; ONLY for scripts/discord-register.sh (never sent to the database)
# Practice calls placed from the Phone Call page (spacetimedb-ts/src/challenge.ts, docs/VOICE.md). All optional:
# unset = the page answers with the private-beta message and nothing is dialed. Names only; set with scripts/set-key.sh.
# RETELL_API_KEY=                     # Retell API key with the webhook badge (places calls, verifies webhooks)
# RETELL_AGENT_ID=                    # the SafeSense practice-caller agent
# CHALLENGE_NUMBER=                   # E.164 from_number for outbound practice calls
# CHALLENGE_ALLOWED_NUMBERS=          # comma-separated E.164 numbers invited to the beta
# VOICE_WEBHOOK_SECRET=               # optional shared secret for /voice/context and /voice/result
# SMS enrollment (JOIN texts, Groq drills) stays OFF: leave CHALLENGE_ENABLED unset.
# CHALLENGE_ENABLED=
# CHALLENGE_ROUTE_BASE=
# CHALLENGE_GROQ_KEY=
# CHALLENGE_GROQ_MODEL=
